{
  "name": "loadnote",
  "version": "1.4.1",
  "description": "An adaptive strength-training log that learns how you train.",
  "private": true,
  "scripts": {
    "test": "node scripts/test.js",
    "check": "node scripts/check.js",
    "sync": "node scripts/sync-www.js && npx cap sync",
    "sync:web": "node scripts/sync-www.js",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios",
    "start:coach": "node backend/server.js",
    "test:browser": "playwright test",
    "serve": "node scripts/serve.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "playwright": "1.62.1"
  }
}
