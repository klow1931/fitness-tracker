# Loadnote backend example configuration
PORT=8787
NODE_ENV=development

# Server-side AI provider configuration. Never put provider secrets in client code.
LOADNOTE_AI_API_KEY=
LOADNOTE_AI_BASE_URL=https://api.x.ai/v1
LOADNOTE_AI_MODEL=grok-2-latest

# Application session signing. Use a high-entropy value of at least 32 bytes.
LOADNOTE_AUTH_SECRET=
LOADNOTE_REQUIRE_AUTH=0
LOADNOTE_SESSION_TTL_SECONDS=43200
LOADNOTE_SESSION_SAMESITE=Strict
LOADNOTE_COOKIE_SECURE=0

# v2.57 durable account/identity store.
# Production authenticated deployments must set an explicit persistent path.
LOADNOTE_ACCOUNT_STORE_PATH=

# Generic OpenID Connect provider. Production authenticated deployments require this configuration.
LOADNOTE_OIDC_ISSUER=
LOADNOTE_OIDC_CLIENT_ID=
LOADNOTE_OIDC_CLIENT_SECRET=
LOADNOTE_OIDC_REDIRECT_URI=
LOADNOTE_OIDC_PROVIDER_ID=
LOADNOTE_OIDC_PROVIDER_NAME=Sign in

# Comma-separated exact origins for credentialed cross-origin app/API requests.
# Native Capacitor origins must be listed explicitly when calling a separate API host.
LOADNOTE_ALLOWED_ORIGINS=

# DEVELOPMENT / TEST ONLY. The server forcibly disables this when NODE_ENV=production.
LOADNOTE_DEV_AUTH=0
LOADNOTE_DEV_AUTH_KEY=
